      "id": "9d38e32d-67b8-4fba-a86a-48797a6698f8",
      "name": "Meta: verificar webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 180]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const query = $input.first().json.query ?? {};\nconst expected = $env.WHATSAPP_VERIFY_TOKEN;\nconst valid = Boolean(expected && query['hub.mode'] === 'subscribe' && query['hub.verify_token'] === expected && query['hub.challenge']);\nreturn [{ json: { statusCode: valid ? 200 : 403, body: valid ? String(query['hub.challenge']) : 'Forbidden' } }];"
      },
      "id": "675ace87-4fcb-4ba8-b7f0-12f50a9fa91d",
