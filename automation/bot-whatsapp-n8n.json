    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Clasificá el mensaje en una sola intención: turno, historia, seguimiento, urgencia u otro. No respondas al usuario, no des diagnósticos ni tratamientos. Devolvé solo JSON con la forma {\\\"intencion\\\":\\\"turno|historia|seguimiento|urgencia|otro\\\"}.' }, { role: 'user', content: JSON.stringify({ mensaje: $('Parsear mensajes entrantes Meta').item.json.text }) } ] } }}",
        "options": {}
      },
      "id": "f4ed4d0a-0d1c-4e5c-9fed-ddf8e2bf85e4",
      "name": "Clasificar intención con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 480],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const content = $input.first().json.choices?.[0]?.message?.content;\nconst allowed = new Set(['turno', 'historia', 'seguimiento', 'urgencia', 'otro']);\nlet intent = 'otro';\ntry {\n  const parsed = JSON.parse(content ?? '{}');\n  if (allowed.has(parsed.intencion)) intent = parsed.intencion;\n} catch {}\nconst replies = {\n  turno: 'Recibimos tu solicitud de turno. Recepción te contactará para confirmar disponibilidad. Este mensaje no reserva un turno.',\n  historia: 'Por privacidad, no compartimos el HISTORIAL DEL PACIENTE por WhatsApp. Contactá a recepción por los canales oficiales.',\n  seguimiento: 'Recibimos tu mensaje y lo derivaremos al equipo. Si necesitás atención urgente, acudí a una guardia o contactá al servicio local de emergencias.',\n  urgencia: 'Este WhatsApp no brinda atención de emergencia. Si hay una urgencia, acudí a una guardia o llamá al servicio local de emergencias.',\n  otro: 'Gracias por comunicarte. Recepción revisará tu mensaje. Evitá enviar información clínica sensible por este canal.'\n};\nreturn [{ json: { intencion: intent, respuesta: replies[intent] } }];"
      },
