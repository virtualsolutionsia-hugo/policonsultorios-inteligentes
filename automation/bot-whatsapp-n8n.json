          "responseCode": 200
        }
      },
      "id": "341f2a47-2f35-4ce1-9df7-305b634ab873",
      "name": "Meta: recibir mensajes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 480]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json.body ?? $input.first().json;\nconst output = [];\nfor (const entry of payload.entry ?? []) {\n  for (const change of entry.changes ?? []) {\n    const value = change.value ?? {};\n    const phoneNumberId = value.metadata?.phone_number_id;\n    for (const message of value.messages ?? []) {\n      if (!phoneNumberId || !message.from || !message.id) continue;\n      let text = '';\n      if (message.type === 'text') text = message.text?.body ?? '';\n      else if (message.type === 'interactive') text = message.interactive?.button_reply?.title ?? message.interactive?.list_reply?.title ?? '';\n      else text = '[Contenido no textual: ' + String(message.type ?? 'desconocido') + ']';\n      output.push({ json: { phone_number_id: String(phoneNumberId), from: String(message.from), provider_message_id: String(message.id), message_type: String(message.type ?? 'unknown'), text: String(text).slice(0, 4000) } });\n    }\n  }\n}\nreturn output;"
      },
