      "id": "6513922b-8b76-4914-b3cc-1f5a24d6c930",
      "name": "Registrar mensaje entrante (idempotente)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 480]
