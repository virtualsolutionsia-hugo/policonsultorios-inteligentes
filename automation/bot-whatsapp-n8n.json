      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 180]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{$json.body}}",
        "options": {
          "responseCode": "={{$json.statusCode}}"
        }
      },
      "id": "06b72f79-5c4d-43ca-b8af-d55452884729",
      "name": "Responder verificación Meta",
      "type": "n8n-nodes-base.respondToWebhook",
