# Supabase: usar la Service Role Key solo desde n8n/backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Meta WhatsApp Cloud API.
WHATSAPP_CLOUD_TOKEN=replace-me
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-value
WHATSAPP_GRAPH_API_VERSION=vXX.X

# Clasificación de intención; confirmar condiciones de privacidad antes de usar datos reales.
OPENAI_API_KEY=replace-me
